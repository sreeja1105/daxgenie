GEMINI_API_KEY=your_gemini_api_key_here

# Optional: API key for FastAPI endpoints (leave blank to disable auth)
SERVICE_API_KEY=your_service_api_key_here

# Rate limit (requests per minute per API key). Default: 60
RATE_LIMIT_PER_MIN=60

# Local backend URL used by the Streamlit UI when calling the FastAPI service
API_BACKEND_URL=http://localhost:8000
